# Convex writes CONVEX_DEPLOYMENT / CONVEX_URL into .env.local automatically.
# Everything below is set on the deployment, not read from this file:
#   npx convex env set APIFY_TOKEN ...

# Apify — scrapes the city
APIFY_TOKEN=

# Gemini — lyrics, Lyria song, Nano Banana postcard
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_MUSIC_MODEL=lyria-3-clip-preview

# Vapi — optional announcement call
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Resend — optional email delivery (share sheet works without it)
RESEND_API_KEY=
RESEND_FROM=
